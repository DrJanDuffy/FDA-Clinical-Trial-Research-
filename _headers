/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https://clinicaltrials.gov https://www.ebi.ac.uk https://api.fda.gov; form-action 'none'; frame-ancestors 'none'; base-uri 'self'

/assets/*
  Cache-Control: public, max-age=3600, must-revalidate
